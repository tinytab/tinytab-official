# Univo license center, staging. The site posts to the primary and retries on the backup only when the primary is
# unreachable.
VITE_API_PRIMARY=https://univo-api-staging.xinlu.ink
VITE_API_BACKUP=https://univo-api-backup-staging.xinlu.ink
# Public site key of the staging Turnstile widget shared by the Univo sites. Its secret stays in the server
# environment. For local development the page origin (for example http://localhost:5173) must be registered as a
# site origin of the product and on the Turnstile widget.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAGCyIfoU4yZAJvIY
