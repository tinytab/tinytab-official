{
  "name": "tinytab-official",
  "version": "1.0.0",
  "private": true,
  "description": "TinyTab website: product pages and the purchase form that submits orders to the Univo license center.",
  "homepage": "https://tinytab.xinlu.ink/",
  "bugs": {
    "url": "https://github.com/tinytab/feedback/issues"
  },
  "license": "MIT",
  "author": "Nicholas Hsiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinytab/tinytab-official.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "locales:hant": "node scripts/locales-hant.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "uqr": "^0.1.3",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "code-inspector-plugin": "^2.0.9",
    "opencc-js": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
